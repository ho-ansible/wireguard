# {{ ansible_managed }}

[NetDev]
Name={{ wg_name }}
Kind=wireguard

[WireGuard]
ListenPort={{ wg_port }}
PrivateKey="{{ lookup('vars', 'wg_keys_' ~ wg_name).pub }}"
{% if wg_fwmark is defined %}
FwMark={{ wg_fwmark }}
{% endif %}
{% if wg_route_table is defined %}
RouteTable={{ wg_route_table }}
{% endif %}
{% if wg_route_metric is defined %}
RouteMetric={{ wg_route_metric }}
{% endif %}

{% for peer in q('inventory_hostnames', wg_peers) | sort
  if peer != inventory_hostname and 
  hostvars[peer]['wg_keys_' ~ wg_name] is defined %}
{%   set hv = hostvars[peer] %}
# {{ peer }}
[WireGuardPeer]
PublicKey={{ hv['wg_keys_' ~ wg_name].pub }}
{%   for sn in hv.wg_allowedips %}
AllowedIPs={{ sn }}
{%   endfor %}
{%   if hv.wg_ext_ip is defined and hv.wg_port is defined %}
Endpoint={{ hv.wg_ext_ip }}:{{ hv.wg_port }}
{%   endif %}
{%   if wg_psk is defined %}
PresharedKey={{ wg_psk }}
{%   endif %}
{%   if wg_keepalive is defined %}
PersistentKeepalive={{ wg_keepalive }}
{%   endif %}

{% endfor %}
